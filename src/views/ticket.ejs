<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ITicket</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#edf2f7;
    font-family:Arial, Helvetica, sans-serif;
    padding:40px;
}

.ticket{

    width:720px;
    margin:auto;

    background:#fff;

    border-radius:18px;

    overflow:hidden;

    box-shadow:0 15px 40px rgba(0,0,0,.15);

}

.poster img{

    width:100%;
    height:250px;
    object-fit:cover;

}

.header{

    background:#006DFF;
    color:#fff;

    padding:25px;

}

.header h1{

    font-size:34px;
    margin-bottom:8px;

}

.header p{

    opacity:.9;

}

.content{

    padding:35px;

}

.section-title{

    font-size:24px;
    color:#006DFF;

    margin-bottom:20px;

}

.row{

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:14px 0;

    border-bottom:1px solid #ececec;

}

.row strong{

    color:#555;

}

.row span{

    font-weight:bold;

}

.ticket-number{

    margin-top:25px;

    background:#f5f7fb;

    border-radius:10px;

    padding:15px;

    text-align:center;

}

.ticket-number h3{

    color:#006DFF;
    margin-bottom:8px;

}

.qr{

    margin-top:35px;

    text-align:center;

}

.qr img{

    width:220px;

}

.footer{

    margin-top:30px;

    text-align:center;

    color:#777;

    font-size:14px;

    padding-bottom:30px;

}

</style>

</head>

<body>

<div class="ticket">

    <% if(ticket.EventSeat.Event.image_url){ %>

    <div class="poster">

        <img src="<%= ticket.EventSeat.Event.image_url %>">

    </div>

    <% } %>

    <div class="header">

        <h1>ITICKET</h1>

        <p>Electronic Ticket</p>

    </div>

    <div class="content">

        <h2 class="section-title">
            <%= ticket.EventSeat.Event.name %>
        </h2>

        <div class="row">
            <strong>Venue</strong>

            <span>
                <%= ticket.EventSeat.Event.Venue.name %>
            </span>
        </div>

        <div class="row">
            <strong>Date</strong>

            <span>
                <%= new Date(ticket.EventSeat.Event.date).toLocaleString("en-GB") %>
            </span>
        </div>

        <div class="row">
            <strong>Section</strong>

            <span>
                <%= ticket.EventSeat.Seat.Seating.name %>
            </span>
        </div>

        <div class="row">
            <strong>Seat</strong>

            <span>

                <%= ticket.EventSeat.Seat.row %>-<%= ticket.EventSeat.Seat.seat_number %>

            </span>
        </div>

        <div class="row">
            <strong>Price</strong>

            <span>

                <%= ticket.EventSeat.price %> AZN

            </span>
        </div>

        <div class="ticket-number">

            <h3>Ticket Number</h3>

            <strong>

                TK-2026-<%= String(ticket.id).padStart(6,"0") %>

            </strong>

        </div>

        <div class="qr">

            <h3>QR CODE</h3>

            <% if(typeof qrImage !== "undefined"){ %>

                <img src="<%= qrImage %>">

            <% }else{ %>

                <p><%= ticket.qr_code %></p>

            <% } %>

        </div>

    </div>

    <div class="footer">

        Thank you for choosing ITICKET

    </div>

</div>

</body>
</html>